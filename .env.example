# Modèle du fichier .env (à copier en .env, qui n'est JAMAIS versionné).
# Générer chaque secret avec :  openssl rand -hex 32
# (hexadécimal = pas de caractère spécial qui casserait les URL de connexion)

# --- Caddy : API OVH pour le challenge DNS-01 -------------------------------------
# Le site est servi sur <OVH_SUBDOMAIN>.<OVH_ZONE> (ex. erp.<domaine>).
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=<cle-application>
OVH_APPLICATION_SECRET=<secret-application>
OVH_CONSUMER_KEY=<consumer-key>
OVH_ZONE=<domaine>
OVH_SUBDOMAIN=erp
OVH_TTL=60
# Décommenter pour les premiers essais (certificat de test, pas de limite Let's Encrypt) :
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# --- Application ----------------------------------------------------------------------
# prod : documentation /docs désactivée. Sur le serveur de TEST, « dev » permet
# d'ouvrir https://erp.<domaine>/api/docs (via le VPN).
ENVIRONMENT=prod
# Propriétaire GitHub des images (ghcr.io/<GHCR_OWNER>/erp-backend), en minuscules.
GHCR_OWNER=<utilisateur-github>
# Version déployée. Poste de dev : « dev » (images construites localement).
# Serveur : mise à jour par ./server/deploy.sh X.Y.Z
ERP_VERSION=dev

# --- PostgreSQL -----------------------------------------------------------------------
# Super-utilisateur « postgres » : seulement pour l'administration de la base.
POSTGRES_SUPERUSER_PASSWORD=<secret>
# Propriétaire des tables : utilisé uniquement par le job de migration.
ERP_OWNER_PASSWORD=<secret>
# Rôle de l'API : lecture/écriture des données, soumis à la Row-Level Security.
ERP_APP_PASSWORD=<secret>

# --- Authentification -----------------------------------------------------------------
# Clé de signature des jetons JWT. La changer déconnecte tout le monde.
JWT_SECRET=<secret>
